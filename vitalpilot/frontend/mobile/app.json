{
  "expo": {
    "name": "VitalPilot",
    "slug": "vitalpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/vitalpilot/launcher-icon.png",
    "scheme": "vitalpilot",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/vitalpilot/launcher-icon.png",
      "bundleIdentifier": "com.vitalpilot.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F6F8",
        "foregroundImage": "./assets/images/vitalpilot/launcher-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/vitalpilot/logo_green.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F8",
          "image": "./assets/images/vitalpilot/logo_green.png",
          "imageWidth": 132
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.123952545473-snihrina8crjf4s8iuu563jnoct86e47"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow VitalPilot to use your location to find doctors in your area.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
