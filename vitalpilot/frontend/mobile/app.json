{
  "expo": {
    "name": "VitalPilot",
    "slug": "vitalpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/vitalpilot/logo_green.png",
    "scheme": "vitalpilot",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/vitalpilot/logo_green.png"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/vitalpilot/logo_green.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/vitalpilot/logo_green.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/vitalpilot/logo_green.png",
          "imageWidth": 132
        }
      ],

      "expo-font",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}