# Add these values to the root backend .env. Never use EXPO_PUBLIC_ for AI keys.
GEMINI_API_KEY=
# Omar's current team model; set to a model enabled for your API project.
GEMINI_REPORT_MODEL=gemini-3.5-flash
# Optional: absolute path to a private persistent directory for PDFs.
# Default: <repository>/.reports
# VITALPILOT_REPORT_DIR=/path/to/private/persistent/reports
